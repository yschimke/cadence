{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/London)"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false
    },
    {
      "groupName": "Kotlin",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin($|[.:])/",
        "/^org\\.jetbrains\\.kotlinx($|[.:])/"
      ]
    },
    {
      "description": "Ignore kotlinx-datetime *-compat artifacts that keep the legacy 0.6.x API",
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-datetime"],
      "allowedVersions": "!/-compat$/"
    },
    {
      "groupName": "Compose Multiplatform",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.compose($|[.:])/",
        "/^org\\.jetbrains\\.androidx\\.lifecycle($|[.:])/",
        "/^org\\.jetbrains\\.androidx\\.navigation($|[.:])/"
      ]
    },
    {
      "groupName": "AndroidX",
      "matchPackageNames": [
        "/^androidx\\./"
      ]
    },
    {
      "groupName": "Ktor",
      "matchPackageNames": [
        "/^io\\.ktor($|[.:])/"
      ]
    },
    {
      "groupName": "Android Gradle Plugin",
      "matchPackageNames": [
        "com.android.application",
        "com.android.library",
        "com.android.tools.build:gradle"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "compose-ai-tools ships the preview CLI, the ee.schimke.composeai Gradle plugin, and the reusable CI composite actions as a single release. Track it aggressively so CI always runs the latest renderer: one grouped PR (so the pinned action refs never skew apart from the catalog plugin pin), no weekly-window wait, and automerge once green.",
      "matchPackageNames": [
        "yschimke/compose-ai-tools",
        "/^ee\\.schimke\\.composeai($|[.:])/"
      ],
      "groupName": "compose-ai-tools",
      "schedule": ["at any time"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
