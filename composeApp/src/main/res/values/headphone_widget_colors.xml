<?xml version="1.0" encoding="utf-8"?>
<!-- Headphone widget roles for pre-Android 16 launchers, from the system's dynamic palette
     (Material 3 light roles; night values in values-night). -->
<resources>
    <color name="headphone_widget_background">@android:color/system_neutral1_50</color>
    <color name="headphone_widget_on_background">@android:color/system_neutral1_900</color>
    <color name="headphone_widget_supporting">@android:color/system_neutral2_700</color>
    <color name="headphone_widget_tonal">@android:color/system_accent2_100</color>
    <color name="headphone_widget_on_tonal">@android:color/system_accent2_900</color>
    <color name="headphone_widget_accent">@android:color/system_accent3_600</color>
</resources>
