<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#191e22">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/cloud_source" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#f0f1f2" android:textSize="14sp" android:maxLines="1" />
    <ImageButton android:id="@+id/cloud_refresh" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_popup_sync" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Refresh podcasts" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/cloud_download" android:layout_width="0dp" android:layout_weight="1" android:minWidth="0dp" android:layout_height="56dp" android:textSize="11sp" android:drawableTop="@android:drawable/stat_sys_download" />
    <Button android:id="@+id/cloud_process" android:layout_width="0dp" android:layout_weight="1" android:minWidth="0dp" android:layout_height="56dp" android:textSize="11sp" android:drawableTop="@android:drawable/ic_menu_manage" />
  </LinearLayout>
  <TextView android:id="@+id/cloud_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#c3cbd0" android:textSize="12sp" android:maxLines="2" />
</LinearLayout>
