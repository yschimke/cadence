<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for launchers without Remote Compose (before Android 16); mirrors
     HeadphoneControlsWidgetContent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/headphone_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/headphone_widget_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/headphone_widget_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/headphone_widget_on_background"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/headphone_widget_now_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/headphone_widget_on_background"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/headphone_widget_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/headphone_widget_supporting"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/headphone_widget_previous"
            style="@style/HeadphoneWidgetButton"
            android:contentDescription="Previous"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/headphone_widget_play"
            style="@style/HeadphoneWidgetButton"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/headphone_widget_pause"
            style="@style/HeadphoneWidgetButton"
            android:contentDescription="Pause"
            android:src="@android:drawable/ic_media_pause" />

        <ImageButton
            android:id="@+id/headphone_widget_next"
            style="@style/HeadphoneWidgetButton"
            android:contentDescription="Next"
            android:src="@android:drawable/ic_media_next" />

        <Button
            android:id="@+id/headphone_widget_mode_mp3"
            style="@style/HeadphoneWidgetModeButton"
            android:contentDescription="Switch to MP3"
            android:text="MP3" />

        <Button
            android:id="@+id/headphone_widget_mode_bluetooth"
            style="@style/HeadphoneWidgetModeButton"
            android:contentDescription="Switch to Bluetooth"
            android:text="BT" />
    </LinearLayout>
</LinearLayout>
