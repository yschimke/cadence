{
  "name": "coo.ee/env • android,android-cli,android-emulator,compose,java (image)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "BASE": "mcr.microsoft.com/devcontainers/base:ubuntu"
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "postCreateCommand": "curl -fsSL https://env.coo.ee/android,android-cli,android-emulator,compose,java | bash",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "containerEnv": {
    "COOEE_ALLOWED_DOMAINS": "api.adoptium.net,api.foojay.io,cache.nixos.org,central.sonatype.com,channels.nixos.org,dl.google.com,fonts.googleapis.com,fonts.gstatic.com,github.com,install.determinate.systems,jitpack.io,maven.google.com,objects.githubusercontent.com,packages.jetbrains.team,repo.gradle.org,services.gradle.org"
  }
}
