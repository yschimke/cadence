{
  "name": "coo.ee/env • android,android-cli,android-emulator,compose,java (image)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "BASE": "mcr.microsoft.com/devcontainers/base:ubuntu"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "postCreateCommand": "bash -o pipefail -c 'curl -fsSL https://env.coo.ee/android,android-cli,android-emulator,compose,java | bash'",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "containerEnv": {
    "COOEE_ALLOWED_DOMAINS": "api.adoptium.net,api.foojay.io,cache.nixos.org,central.sonatype.com,channels.nixos.org,dl.google.com,env.coo.ee,fonts.googleapis.com,fonts.gstatic.com,github.com,install.determinate.systems,jitpack.io,jogamp.org,maven.google.com,objects.githubusercontent.com,oss.sonatype.org,packages.jetbrains.team,plugins-artifacts.gradle.org,plugins.gradle.org,repo.gradle.org,repo.maven.apache.org,services.gradle.org"
  }
}
